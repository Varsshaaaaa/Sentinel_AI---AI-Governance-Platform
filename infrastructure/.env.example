# SentinelAI infrastructure environment
# Copy to infrastructure/.env and customize

AWS_REGION=us-east-1
PROJECT_NAME=sentinelai
ENVIRONMENT=dev

DYNAMODB_TABLE_PREFIX=sentinelai-dev
EVENTBRIDGE_BUS_NAME=sentinelai-dev-governance

# Lambda (optional — set DEPLOY_LAMBDA=true in deploy-aws.sh)
LAMBDA_FUNCTION_NAME=sentinelai-dev-api
LAMBDA_ROLE_ARN=
# LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/sentinelai-lambda-role

DEPLOY_LAMBDA=false
DELETE_LAMBDA=false
DEPLOY_WAF_WEBSOCKET=true

# WebSocket (created by create-websocket-api.sh)
LAMBDA_WS_FUNCTION_NAME=sentinelai-dev-waf-ws
WAF_WEBSOCKET_STAGE=prod
