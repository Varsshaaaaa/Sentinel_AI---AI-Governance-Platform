resource "aws_dynamodb_table" "agents" {
  name         = "${local.dynamodb_table_prefix}-agents"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "PK"
  range_key    = "SK"

  attribute {
    name = "PK"
    type = "S"
  }
  attribute {
    name = "SK"
    type = "S"
  }
}

